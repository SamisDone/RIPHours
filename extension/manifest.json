{
  "manifest_version": 3,
  "name": "RIPHours",
  "version": "1.3.0",
  "description": "Counts the time you spend on the sites you choose, in days of your life, and blocks them when you've had enough.",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "notifications",
    "contextMenus",
    "offscreen",
    "scripting",
    "favicon"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "RIPHours",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
